------------------------------------------------------------------------------
R5  THE EQUATIONS OF MOTION
------------------------------------------------------------------------------
route (a), from the extended Hamel equation:
    j = 1 :  ((2*Lls*w)/3 + Lms*w)*xi[2][t] + (2*Lls*Derivative[1][xi[1]][t])/3 + Lms*(w*xi[5][t] + Derivative[1][xi[1]][t] + Derivative[1][xi[4]][t])
    j = 2 :  -1/3*((2*Lls + 3*Lms)*w*xi[1][t]) + (2*Lls*Derivative[1][xi[2]][t])/3 + Lms*(-(w*xi[4][t]) + Derivative[1][xi[2]][t] + Derivative[1][xi[5]][t])
    j = 3 :  (Lls*Derivative[1][xi[3]][t])/3
    j = 4 :  Lms*xi[2][t]*(w - xi[7][t]) + ((2*aa^2*Llr + 3*Lms)*xi[5][t]*(w - xi[7][t]) + 3*Lms*Derivative[1][xi[1]][t] + (2*aa^2*Llr + 3*Lms)*Derivative[1][xi[4]][t])/3
    j = 5 :  -1/3*((2*aa^2*Llr + 3*Lms)*xi[4][t]*(w - xi[7][t])) + Lms*xi[1][t]*(-w + xi[7][t]) + Lms*Derivative[1][xi[2]][t] + ((2*aa^2*Llr + 3*Lms)*Derivative[1][xi[5]][t])/3
    j = 6 :  (aa^2*Llr*Derivative[1][xi[6]][t])/3
    j = 7 :  Lms*xi[2][t]*xi[4][t] - Lms*xi[1][t]*xi[5][t] + Jm*Derivative[1][xi[7]][t]
route (b), from the Euler-Lagrange equations in the abc coordinates:
    j = 1 :  ((2*Lls*w)/3 + Lms*w)*xi[2][t] + (2*Lls*Derivative[1][xi[1]][t])/3 + Lms*(w*xi[5][t] + Derivative[1][xi[1]][t] + Derivative[1][xi[4]][t])
    j = 2 :  -1/3*((2*Lls + 3*Lms)*w*xi[1][t]) + (2*Lls*Derivative[1][xi[2]][t])/3 + Lms*(-(w*xi[4][t]) + Derivative[1][xi[2]][t] + Derivative[1][xi[5]][t])
    j = 3 :  (Lls*Derivative[1][xi[3]][t])/3
    j = 4 :  Lms*xi[2][t]*(w - xi[7][t]) + ((2*aa^2*Llr + 3*Lms)*xi[5][t]*(w - xi[7][t]) + 3*Lms*Derivative[1][xi[1]][t] + (2*aa^2*Llr + 3*Lms)*Derivative[1][xi[4]][t])/3
    j = 5 :  -1/3*((2*aa^2*Llr + 3*Lms)*xi[4][t]*(w - xi[7][t])) + Lms*xi[1][t]*(-w + xi[7][t]) + Lms*Derivative[1][xi[2]][t] + ((2*aa^2*Llr + 3*Lms)*Derivative[1][xi[5]][t])/3
    j = 6 :  (aa^2*Llr*Derivative[1][xi[6]][t])/3
    j = 7 :  Lms*xi[2][t]*xi[4][t] - Lms*xi[1][t]*xi[5][t] + Jm*Derivative[1][xi[7]][t]
R5  count: disagreements between the two routes = 0
