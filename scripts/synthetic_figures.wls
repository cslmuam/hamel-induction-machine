#!/usr/bin/env wolframscript
(* synthetic_figures.wls --- data for the three TikZ figures of manuscript/JNS_LLD_synthetic.tex.
   Writes manuscript/fig_synthetic_data.tex.  Initial state as in block C6 of pendulum_numeric_check.wls; inductances and inertia of
   Krause's 3 hp machine (Table 4.10-1), whose rotor leakage 0.002 H differs from C6's 0.0025 H.

   F2  free machine in the stationary qd0 frame: linkages, rotor speed (Thm eom).
   F3  the same motion in three frames: at rest, uniform rate, varying rate (Thm driven);
       the driven equations are integrated directly and compared with the conjugacy.
   F4  energy level sets in (theta - theta_*, theta') with the Hamel trajectory on one of them
       (Prop integrals), and the exchange J theta' <-> Im(conj(z) zeta) (Prop noether). *)

pars = {Lls -> 0.002, Llr -> 0.002, Lms -> 0.046, a -> 1.0, J -> 0.089};  (* Krause Table 4.10-1, 3 hp: Xls = Xlr = 0.754, XM = 26.13 ohm at 377 rad/s; Lms = (2/3) XM/377 *)
mus = 2/3 Lls + Lms /. pars; mur = 2/3 a^2 Llr + Lms /. pars;
Del = mus mur - Lms^2 /. pars; Lm = Lms /. pars; Jm = J /. pars;
xiF[lqs_, lds_, lqr_, ldr_] := {(mur lqs - Lm lqr)/Del, (mur lds - Lm ldr)/Del,
                                (mus lqr - Lm lqs)/Del, (mus ldr - Lm lds)/Del};
init = {lqs -> 0.9, lds -> 0.35, lqr -> 0.7, ldr -> -0.2, th -> 0.4, om -> 2.0};
opts = Sequence[MaxStepSize -> 0.0002, AccuracyGoal -> 12, PrecisionGoal -> 12];

(* ---- invariants of the free motion ---- *)
lamS = (lqs + I lds) /. init;
zeta0 = ((lqr + I ldr) Exp[I th]) /. init;
kappa = Lm/Del Abs[lamS] Abs[zeta0];
thStar = Arg[zeta0] - Arg[lamS];
Ecal = Jm (om /. init)^2/2 - kappa Cos[(th /. init) - thStar];
Print["kappa = ", kappa, "  theta_* = ", thStar, "  Ecal/kappa = ", Ecal/kappa];
period = If[Ecal < kappa,
  4 EllipticK[((Ecal/kappa + 1)/2)]/Sqrt[kappa/Jm], 0.];
Print["libration period = ", period];
tEnd = 2 period;

(* ---- driven equations in a frame of reference angle th0[t] (f = 0) ---- *)
frameSol[th0_] := Module[{w0},
  w0[t_] := Evaluate[D[th0[t], t]];
  NDSolve[{
    LQS'[t] == -w0[t] LDS[t], LDS'[t] == w0[t] LQS[t],
    LQR'[t] == -(w0[t] - OM[t]) LDR[t], LDR'[t] == (w0[t] - OM[t]) LQR[t],
    Jm OM'[t] == Lm (#[[1]] #[[4]] - #[[2]] #[[3]]) &[xiF[LQS[t], LDS[t], LQR[t], LDR[t]]],
    TH'[t] == OM[t],
    Z'[t] == (#[[3]] + I #[[4]]) Exp[I (TH[t] - th0[t])] &[xiF[LQS[t], LDS[t], LQR[t], LDR[t]]],
    LQS[0] == (lqs /. init), LDS[0] == (lds /. init), LQR[0] == (lqr /. init),
    LDR[0] == (ldr /. init), TH[0] == (th /. init), OM[0] == (om /. init), Z[0] == 0},
   {LQS, LDS, LQR, LDR, TH, OM, Z}, {t, 0, tEnd}, opts][[1]]];

th0Rest[t_] := 0;
th0Unif[t_] := 2 Pi 4 t/tEnd;                       (* four turns over the window *)
th0Vary[t_] := 2 Pi (2 (t/tEnd)^2 + 0.3 Sin[2 Pi t/tEnd]); (* accelerating, non-uniform *)

sR = frameSol[th0Rest]; sU = frameSol[th0Unif]; sV = frameSol[th0Vary];

(* conjugacy check: frame components = stationary components times e^{i th0} *)
tsC = Range[0, tEnd, tEnd/400];
conjErr[s_, th0_] := Max[Table[
   Abs[((LQS[t] + I LDS[t]) /. s) - ((LQS[t] + I LDS[t]) /. sR) Exp[I th0[t]]] +
   Abs[((LQR[t] + I LDR[t]) /. s) - ((LQR[t] + I LDR[t]) /. sR) Exp[I th0[t]]] +
   Abs[(OM[t] /. s) - (OM[t] /. sR)], {t, tsC}]];
Print["F3 conjugacy error, uniform frame = ", conjErr[sU, th0Unif]];
Print["F3 conjugacy error, varying frame = ", conjErr[sV, th0Vary]];

(* invariants in the stationary run *)
zetaT[t_] := ((LQR[t] + I LDR[t]) Exp[I TH[t]]) /. sR;
Efun[t_] := (Jm OM[t]^2/2 - Lm/Del Re[Conjugate[LQS[t] + I LDS[t]] (LQR[t] + I LDR[t])]) /. sR;
Jcal[t_] := (Jm OM[t] + Im[Conjugate[Z[t]] zetaT[t]]) /. sR;
Print["F2 drift |lambda_s| = ", Max[Table[Abs[Abs[(LQS[t] + I LDS[t]) /. sR] - Abs[lamS]], {t, tsC}]]];
Print["F2 drift zeta        = ", Max[Table[Abs[zetaT[t] - zeta0], {t, tsC}]]];
Print["F4 drift energy      = ", Max[Table[Abs[Efun[t] - Efun[0]], {t, tsC}]]];
Print["F4 drift rot. charge = ", Max[Table[Abs[Jcal[t] - Jcal[0]], {t, tsC}]]];

(* ---- formatting ---- *)
fmt[x_] := ToString[NumberForm[N[Re[x]], {6, 4}, ExponentFunction -> (Null &)]];
pt[{x_, y_}] := "(" <> fmt[x] <> "," <> fmt[y] <> ")";
ser[name_, pts_] := "\\def\\" <> name <> "{" <> StringRiffle[pt /@ pts, " "] <> "}";
tsP = Range[0, tEnd, tEnd/240];
tn[t_] := t/tEnd;                                   (* time normalised to the window *)
lsc = Abs[lamS];                                    (* linkages normalised by |lambda_s| *)
osc = Max[Table[Abs[Re[OM[t] /. sR]], {t, tsP}]];

out = {};
AppendTo[out, "% generated by MapleScripts/synthetic_figures.wls, " <>
   DateString[{"Year", "-", "Month", "-", "Day"}] <> " -- do not edit by hand"];
AppendTo[out, "% Krause 3 hp machine (Table 4.10-1); kappa = " <> fmt[kappa] <> " N m; Ecal/kappa = " <> fmt[Ecal/kappa] <>
   "; window = two libration periods = " <> fmt[tEnd] <> " s; linkages / |lambda_s| = " <> fmt[lsc] <>
   " Wb; speed / " <> fmt[osc] <> " rad/s"];

(* F2: stationary frame *)
AppendTo[out, ser["FTwoLqs", Table[{tn[t], (LQS[t] /. sR)/lsc}, {t, tsP}]]];
AppendTo[out, ser["FTwoLds", Table[{tn[t], (LDS[t] /. sR)/lsc}, {t, tsP}]]];
AppendTo[out, ser["FTwoLqr", Table[{tn[t], (LQR[t] /. sR)/lsc}, {t, tsP}]]];
AppendTo[out, ser["FTwoLdr", Table[{tn[t], (LDR[t] /. sR)/lsc}, {t, tsP}]]];
AppendTo[out, ser["FTwoOm", Table[{tn[t], (OM[t] /. sR)/osc}, {t, tsP}]]];

(* F3: lambda_qs and lambda_qr in the three frames *)
Do[AppendTo[out, ser["FThreeQs" <> k[[1]], Table[{tn[t], (LQS[t] /. k[[2]])/lsc}, {t, Range[0, tEnd, tEnd/600]}]]];
   AppendTo[out, ser["FThreeQr" <> k[[1]], Table[{tn[t], (LQR[t] /. k[[2]])/lsc}, {t, Range[0, tEnd, tEnd/600]}]]],
  {k, {{"R", sR}, {"U", sU}, {"V", sV}}}];

(* F4a: level sets of the energy, x = theta - theta_*, y = theta' sqrt(J/kappa) *)
lev[e_, s_] := Module[{xs},
  If[e < 1,
   With[{xm = ArcCos[-e]}, xs = Table[xm Sin[u], {u, -Pi/2, Pi/2, Pi/60}]],
   xs = Table[u, {u, -Pi, Pi, Pi/60}]];
  {#, s Sqrt[Max[0, 2 (e + Cos[#])]]} & /@ xs];
Do[AppendTo[out, ser["FFourUp" <> {"One","Two","Three","Four","Five"}[[i]], lev[{-0.6, 0.0, 0.6, 1.0, 1.6}[[i]], 1]]];
   AppendTo[out, ser["FFourDn" <> {"One","Two","Three","Four","Five"}[[i]], lev[{-0.6, 0.0, 0.6, 1.0, 1.6}[[i]], -1]]], {i, 5}];
traj = Table[{Mod[(TH[t] /. sR) - thStar, 2 Pi, -Pi], (OM[t] /. sR) Sqrt[Jm/kappa]}, {t, Range[0, tEnd, tEnd/36]}];
AppendTo[out, "\\def\\FFourTraj{" <> StringRiffle[pt /@ traj, " "] <> "}"];
AppendTo[out, "\\def\\FFourLevel{" <> fmt[Ecal/kappa] <> "}"];

(* F4b: exchange of the rotational charge, normalised by |Jcal| *)
jsc = Max[Table[Abs[Re[Jm OM[t] /. sR]], {t, tsP}]];
AppendTo[out, ser["FFourJom", Table[{tn[t], (Jm OM[t] /. sR)/jsc}, {t, tsP}]]];
AppendTo[out, ser["FFourImz", Table[{tn[t], Im[Conjugate[Z[t] /. sR] zetaT[t]]/jsc}, {t, tsP}]]];
AppendTo[out, ser["FFourSum", Table[{tn[t], Jcal[t]/jsc}, {t, tsP}]]];
Print["F4b Jcal(0) = ", Jcal[0], "  range Jom/jsc = ", MinMax[Re@Table[(Jm OM[t] /. sR)/jsc, {t, tsP}]],
      "  range Im/jsc = ", MinMax[Re@Table[Im[Conjugate[Z[t] /. sR] zetaT[t]]/jsc, {t, tsP}]]];
Print["F3 ranges qs: ", MinMax[Re@Table[(LQS[t] /. sV)/lsc, {t, tsP}]], "  qr stat: ",
      MinMax[Re@Table[(LQR[t] /. sR)/lsc, {t, tsP}]]];

Export[FileNameJoin[{DirectoryName[$InputFileName], "..", "manuscript", "fig_synthetic_data.tex"}],
  StringRiffle[out, "\n"] <> "\n", "Text"];
Print["written fig_synthetic_data.tex"];
